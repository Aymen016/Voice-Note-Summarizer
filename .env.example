# Required — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — Groq chat model used for summarization
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — faster-whisper model size: tiny | base | small | medium
# small is the default (best CPU speed/accuracy tradeoff); use medium for better Urdu accuracy
# WHISPER_MODEL=small
